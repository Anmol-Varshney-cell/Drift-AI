# Optional: Configure API keys for live LLM execution
# Note: All assignments can run without API keys in autonomous deterministic simulation mode out-of-the-box.

# Google Gemini (Recommended default - Free tier at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (Free tier at https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI (Optional)
OPENAI_API_KEY=your_openai_api_key_here
